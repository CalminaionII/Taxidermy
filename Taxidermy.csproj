<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>taxidermy</AssemblyName>
		<Platforms>AnyCPU</Platforms>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<Prefer32Bit>false</Prefer32Bit>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- KEEP THE LINE NUMBERS, DROP THE PERSONAL PATH. The shipped .pdb turns a stack
		     trace into a file and line, but without PathMap every stranger's log would carry
		     "E:\Game Mods\Vintage Story Mods (AI)\Taxidermy\...". -->
		<PathMap>$(MSBuildProjectDirectory)=.</PathMap>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="tools\**" />
		<None Include="tools\**" />
		<Compile Remove="backup\**" />
		<None Include="backup\**" />
		<Compile Remove="mods\**" />
		<None Include="mods\**" />
	</ItemGroup>

	<!-- ASSETS ARE NOT BUILD OUTPUT. They live in mods\taxidermy_<version>\assets\ beside
	     modinfo.json and modicon.png; package.py zips them from there and takes only the
	     dll, pdb and deps out of bin\. One source per mod. -->

	<!-- 0Harmony IS REFERENCED, for exactly one patch: BarrelRecipe.TryCraftNow clones its
	     output from the recipe and carries over freshness only, so a specimen sealed in a
	     barrel would forget which animal it was. See src/BarrelPatch.cs. Harmony is
	     pardeike/Harmony (MIT), shipped by the game in Lib\; it is not game code. -->

	<!-- WHERE THE GAME DLLS ARE (1.22.7) - the folder holding VintagestoryAPI.dll (with Lib\ and Mods\ inside it).

	     Looked for in this order:
	       1. gamepath.props next to this file - YOUR PC's game folder. It is in .gitignore, so it never
	          goes to GitHub. Copy gamepath.props.example to gamepath.props and put your folder in it.
	       2. the VINTAGE_STORY environment variable (the cloud build uses this).
	       3. the default below: the Wax Light Launcher install, from E:\Game Mods\Vintage Story Mods (AI)\Taxidermy.
	     If none of them has the game, the build stops with a message saying which folder it tried.
	     If the launcher moves again, change gamepath.props (and TESTER in tools/deploy.py). -->
	<Import Project="gamepath.props" Condition="Exists('gamepath.props')" />
	<PropertyGroup>
		<VintageStoryPath Condition="'$(VintageStoryPath)' == '' And '$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)</VintageStoryPath>
		<VintageStoryPath Condition="'$(VintageStoryPath)' == ''">..\..\..\Games\Vintage Story\Wax Light Launcher\Wax Light Info\versions\1.22.7</VintageStoryPath>
	</PropertyGroup>

	<!-- A plain message instead of hundreds of "type not found" errors when the game folder is wrong. -->
	<Target Name="CheckGameFolder" BeforeTargets="ResolveAssemblyReferences">
		<Error Condition="!Exists('$(VintageStoryPath)\VintagestoryAPI.dll')"
		       Text="Vintage Story's game files were not found in: $([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(VintageStoryPath)')))) - copy gamepath.props.example to gamepath.props (next to Taxidermy.csproj) and put the folder that contains VintagestoryAPI.dll in it." />
	</Target>

	<ItemGroup>
		<Reference Include="0Harmony">
			<HintPath>$(VintageStoryPath)\Lib\0Harmony.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="protobuf-net">
			<HintPath>$(VintageStoryPath)\Lib\protobuf-net.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Newtonsoft.Json">
			<HintPath>$(VintageStoryPath)\Lib\Newtonsoft.Json.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Vintagestory">
			<HintPath>$(VintageStoryPath)\Vintagestory.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="VintagestoryAPI">
			<HintPath>$(VintageStoryPath)\VintagestoryAPI.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="VintagestoryLib">
			<HintPath>$(VintageStoryPath)\VintagestoryLib.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="VSSurvivalMod">
			<HintPath>$(VintageStoryPath)\Mods\VSSurvivalMod.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="VSEssentials">
			<HintPath>$(VintageStoryPath)\Mods\VSEssentials.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
</Project>
